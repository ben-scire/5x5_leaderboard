# build environment
FROM node:16-alpine as build
WORKDIR /app
COPY projects/leaderboard/frontend/client/package.json .
COPY projects/leaderboard/frontend/client/package-lock.json .
RUN npm install
COPY projects/leaderboard/frontend/client .
RUN npm run build

# production environment
FROM nginx:stable-alpine
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
